# Copy to .env. Never commit .env.
COMPOSE_PROJECT_NAME=hotel-booking-system
TZ=UTC

# --- MySQL ---
MYSQL_DATABASE=hotel_booking
APP_DB_USER=hbs_app
MYSQL_PORT=3306
# passwords live in ./infra/secrets/*.txt (docker secrets), NOT here

# --- Redis ---
REDIS_PORT=6379

# --- dev tools (profile: tools) ---
CLOUDBEAVER_PORT=8979
REDISINSIGHT_PORT=5541

# --- app wiring (consume from services) ---
DB_HOST=mysql
DB_PORT=3306
REDIS_HOST=redis
